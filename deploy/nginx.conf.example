# EXEMPLO NÃO TESTADO neste ambiente. Ajuste domínio e certificados.
server { listen 80; server_name gestok.example.com; return 301 https://$host$request_uri; }
server {
  listen 443 ssl http2; server_name gestok.example.com;
  ssl_certificate     /etc/letsencrypt/live/gestok.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/gestok.example.com/privkey.pem;
  client_max_body_size 2m;
  location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;      # SOBRESCREVE (não acrescenta) para o cliente não forjar o IP
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
  }
}
# Com este proxy: GESTOK_TRUSTED_PROXIES=1
